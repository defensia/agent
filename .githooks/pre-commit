#!/bin/sh
# Block commits that add secrets. Rules: .gitleaks.toml (defaults + literal
# passwords, which the defaults miss). Enable once per clone:
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not installed (brew install gitleaks) — commit blocked"
    exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner -c "$(git rev-parse --show-toplevel)/.gitleaks.toml"
